# On-demand planetary windows fetched when a user clicks a point (regenerable cache)
data/cache/
data/downloads/
data/patches/**/*.tif
data/patches/**/*.tiff
data/terrain/**/*.tif
data/terrain/**/*.tiff
# Compact, candidate-place windows are source-backed display assets used by
# analogue discovery; keep the global/raw terrain products ignored.
!data/terrain/cop-dem-candidate-earth_*.tif
!data/terrain/mola-candidate-mars_*.tif
# Compact, source-backed MOLA example and paired count mask for offline discovery.
!data/terrain/mola-meg128-mars_aeolis_nondune-01.tif
!data/terrain/mola-meg128-mars_aeolis_nondune-01-counts.tif
!data/terrain/moon_candidate_moon_*.tif
!data/terrain/diviner_moon_mare_tranquillitatis_pit.tif
!data/terrain/tes-mars_jezero.tif
!data/terrain/tes-mars_gale.tif
!data/terrain/tes-mars_viking1.tif
!data/terrain/lola_polar_*.tif
